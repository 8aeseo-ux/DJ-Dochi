{
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "http://qotjdus1016.dothome.co.kr"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "POST, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type"
        },
        {
          "key": "Vary",
          "value": "Origin"
        }
      ]
    }
  ],
  "functions": {
    "api/generate-mixtape.ts": {
      "includeFiles": "prompts/*.md",
      "maxDuration": 60
    },
    "api/extract-playlist.ts": {
      "maxDuration": 60
    }
  }
}
